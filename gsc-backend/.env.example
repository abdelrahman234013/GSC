
# ---------------------------------------------------------------------------
# Redis (optional)
# ---------------------------------------------------------------------------
# Powers two things: the read-through cache for public catalogue pages, and
# shared rate-limit counters.
#
# Leave it UNSET and the app still works — reads go straight to Postgres and
# rate-limit counters live in the process. That is the supported way to run
# locally, in CI, and in the test suite.
#
# Inside docker-compose the hostname is the service name:
#   REDIS_URL=redis://redis:6379
# A managed Redis (Upstash, Redis Cloud) gives you a rediss:// URL with
# credentials — use that verbatim in production.
REDIS_URL=redis://redis:6379

# How long cached catalogue responses stay valid, in seconds. Default 300 (5
# minutes). Admin edits invalidate the cache immediately, so this only bounds
# staleness from changes made outside the API.
CACHE_TTL_SECONDS=300
