generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =========================================================
// Admin & Staff (module 5 — completely separate from customers)
// =========================================================

enum AdminRole {
  ADMIN
  STAFF
}

model Admin {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             AdminRole @default(STAFF)
  sessionTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("admins")
}

// =========================================================
// Customers (modules 3 & 4)
// =========================================================

model Customer {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String?
  googleId         String?   @unique
  name             String?
  phone            String?
  refreshTokenHash String?

  // Hash of the most recently issued password-reset token.
  //
  // Makes a reset link single-use. The JWT alone stays cryptographically valid
  // for its full lifetime, so without this the same link could be used over and
  // over — by anyone who later reached it through a shared computer, a forwarded
  // mailbox, or browser history. Cleared the moment a reset succeeds, and
  // overwritten whenever a new link is requested, so only the newest link works.
  //
  // Stored hashed, not raw: the same reasoning as refreshTokenHash above — a
  // leaked database dump must not hand out working reset links.
  passwordResetTokenHash String?

  emailVerifiedAt  DateTime? // null = not verified yet
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  address Address?
  orders    Order[]
  quotes Quote[]

  @@map("customers")
}

model Address {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fullName    String
  phone       String
  city        String
  addressLine String
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addresses")
}

// =========================================================
// Products / Catalog (module 6) — car springs only, per the brief
// =========================================================

model SpringType {
  id     String @id @default(uuid())
  slug   String @unique
  nameAr String
  nameEn String

  products Product[]
  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spring_types")
}

model Product {
  id   String @id @default(uuid())
  slug String @unique

  nameAr        String
  nameEn        String
  descriptionAr String?
  descriptionEn String?

  springTypeId String
  springType   SpringType @relation(fields: [springTypeId], references: [id])
  wireDiameterMm  Decimal  @db.Decimal(6, 2)
  outerDiameterMm Decimal? @db.Decimal(6, 2)
  innerDiameterMm Decimal? @db.Decimal(6, 2)
  lengthMm        Decimal? @db.Decimal(6, 2)
  materialAr      String
  materialEn      String

  price Decimal @db.Decimal(10, 2)
  stock Int     @default(0)

  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String?
  metaDescriptionEn String?

  images     ProductImage[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key with no automatic index — see the note on OrderItem.orderId.
  // Used by "GET /products?springType=X".
  @@index([springTypeId])
  // Every public catalog page load sorts by this with no other filter, so a
  // plain descending index (not part of a composite) is the right shape here —
  // the busiest read path in the app, per the read-heavy analysis.
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  url      String
  altAr    String?
  altEn    String?
  position Int     @default(0)

  // Foreign key with no automatic index — see the note on OrderItem.orderId.
  // Scanned on every product page load and every image reorder/delete.
  @@index([productId])
  @@map("product_images")
}


// =========================================================
// Checkout & Orders (module 8) — Cash on Delivery only for v1
// =========================================================

enum OrderStatus {
  PROCESSING
  SHIPPING
  DELIVERED
  // Admin-only. Cash on delivery means refused deliveries are routine, and
  // without this there was no way to record one — the order stayed "shipping"
  // forever and its stock stayed decremented for goods that came back.
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique // shown to guests for /orders/track/:order_number
  status      OrderStatus @default(PROCESSING)

  // Client-supplied Idempotency-Key from POST /checkout.
  //
  // The unique index is what actually enforces this: without it, two requests
  // carrying the same key could both pass a "does this exist yet?" check and both
  // insert. With it, the database rejects the second one, and the handler returns
  // the order the first request created. That is the difference between a
  // duplicate order and a safe retry — and for cash on delivery, a duplicate is
  // two vans sent to one address.
  //
  // Scoped per customer (see @@unique below) rather than globally unique: two
  // different customers whose clients both send a naive key like "1" must not
  // collide with each other.
  //
  // Nullable because the header is optional; orders placed without one simply
  // have no retry protection. Postgres allows many NULLs in a unique index, so
  // those orders never conflict.
  idempotencyKey String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  // Guest checkout: no customer account, so contact/delivery info is captured directly.
  contactName  String
  contactPhone String
  contactEmail String?
  city         String
  addressLine  String
  notes        String?

  totalAmount Decimal @db.Decimal(10, 2)

  // Set when an admin cancels. Kept as a record rather than deleting the row:
  // an order is an accounting document, and "why did this not go ahead?" is a
  // question that gets asked weeks later during a dispute or a stock count.
  cancelledAt        DateTime?
  cancellationReason String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, idempotencyKey])
  // Serves "GET /customers/me/orders" (WHERE customerId = ? ORDER BY createdAt
  // DESC) in one index pass — filter and sort together, not just the filter.
  // Also covers the customerId foreign key on its own, so no separate
  // single-column index on customerId is needed.
  @@index([customerId, createdAt(sort: Desc)])
  // Serves "GET /admin/orders?status=X", same reasoning: filter + sort in one
  // index rather than an index scan followed by a separate sort step.
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  nameSnapshotAr String
  nameSnapshotEn String
  priceSnapshot  Decimal @db.Decimal(10, 2)
  quantity       Int

  // Postgres does not index foreign keys automatically (unlike MySQL/InnoDB) —
  // without this, loading an order's line items via `include: { items: true }`
  // is a full scan of order_items for every single order fetched.
  @@index([orderId])
  @@map("order_items")
}

// =========================================================
// Custom Quote / RFQ (module 9)
// =========================================================

enum QuoteStatus {
  PENDING
  QUOTED
  CLOSED
}

model Quote {
  id              String      @id @default(uuid())
  referenceNumber String      @unique
  status          QuoteStatus @default(PENDING)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  springTypeId    String?
  springType      SpringType? @relation(fields: [springTypeId], references: [id])
  wireDiameterMm  Decimal? @db.Decimal(6, 2)
  outerDiameterMm Decimal? @db.Decimal(6, 2)
  innerDiameterMm Decimal? @db.Decimal(6, 2)
  lengthMm        Decimal? @db.Decimal(6, 2)
  coilCount       Int?
  material        String?
  quantity        Int
  notes           String?

  contactName  String
  contactPhone String
  contactEmail String?

  quotedPrice Decimal? @db.Decimal(10, 2)
  staffNotes  String?

  files QuoteFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Same reasoning as Order above: filter + sort together for
  // "GET /customers/me/quotes" and "GET /admin/quotes?status=X".
  @@index([customerId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  // Foreign key with no automatic index — see the note on OrderItem.orderId.
  @@index([springTypeId])
  @@map("quotes")
}

model QuoteFile {
  id           String @id @default(uuid())
  quoteId      String
  quote        Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  url          String
  originalName String?

  @@index([quoteId])
  @@map("quote_files")
}

// =========================================================
// Content / CMS (module 11)
// =========================================================

model ContentPage {
  id   String @id @default(uuid())
  slug String @unique // e.g. "home", "about", "products-capabilities", "contact"

  titleAr String?
  titleEn String?
  bodyAr  Json // flexible block content — this is the JSONB use case Postgres covers
  bodyEn  Json

  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String?
  metaDescriptionEn String?

  updatedAt DateTime @updatedAt

  @@map("content_pages")
}

model TimelineEntry {
  id            String  @id @default(uuid())
  year          Int
  titleAr       String
  titleEn       String
  descriptionAr String?
  descriptionEn String?
  position      Int     @default(0)

  createdAt DateTime @default(now())

  @@map("timeline_entries")
}

// =========================================================
// Gallery / Media (module 12)
// =========================================================

enum GalleryCategory {
  FACTORY_INTERIOR
  MACHINES
  FINISHED_PRODUCT
  MANUFACTURING_PROCESS
}

model GalleryImage {
  id        String          @id @default(uuid())
  url       String
  category  GalleryCategory
  captionAr String?
  captionEn String?
  altAr     String?
  altEn     String?
  position  Int             @default(0)

  createdAt DateTime @default(now())

  @@map("gallery_images")
}

model GalleryVideo {
  id       String  @id @default(uuid())
  url      String // uploaded file URL or embed link (e.g. YouTube)
  titleAr  String?
  titleEn  String?
  position Int     @default(0)

  createdAt DateTime @default(now())

  @@map("gallery_videos")
}

// =========================================================
// Clients & Case Studies (module 13)
// =========================================================

model Client {
  id            String  @id @default(uuid())
  name          String
  logoUrl       String
  descriptionAr String?
  descriptionEn String?
  position      Int     @default(0)

  createdAt DateTime @default(now())

  @@map("clients")
}

model CaseStudy {
  id      String @id @default(uuid())
  slug    String @unique // e.g. "king-fahd-causeway"
  titleAr String
  titleEn String
  bodyAr  Json
  bodyEn  Json
  images  Json // array of image URLs

  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("case_studies")
}

// =========================================================
// Admin Dashboard & Settings (module 14) — singleton settings row
// =========================================================

model SiteSettings {
  id              String @id @default("singleton")
  contactPhone    String
  contactEmail    String
  contactWhatsapp String?
  socialLinks     Json // e.g. { "linkedin": "...", "googleBusiness": "..." }

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}